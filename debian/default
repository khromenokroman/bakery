# Параметры службы bakery. После изменения: systemctl restart bakery
#
# --host 0.0.0.0  доступ из локальной сети (пароли идут без шифрования: только доверенная сеть)
# --backup-dir  каталог резервных копий (по умолчанию /var/lib/bakery/backups)
# --host 127.0.0.1  только с этой машины
# --port  порт HTTP
BAKERY_OPTS="--host 0.0.0.0 --port 8080"
